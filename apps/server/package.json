  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohanSardar/ozi-harness",
    "directory": "apps/server"
  },
  "bin": {
    "ozi": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts serve",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc-rs --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@earendil-works/pi-tui": "1.4.0",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@ozi/pi": "workspace:*",
    "@t3tools/provider-core": "workspace:*",
    "@t3tools/provider-pi": "workspace:*",
    "effect": "catalog:",
    "jose": "catalog:",
    "pi-claude-bridge": "0.9.3",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@t3tools/client-runtime": "workspace:*",
