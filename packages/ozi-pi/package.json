{
  "name": "@ozi/pi",
  "version": "0.1.0",
  "description": "Ozi main for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "bin": {
    "ozi-harness": "./src/cli.mjs"
  },
  "files": [
    "src",
    "patch-bridge.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./Evidence": "./src/Evidence.ts",
    "./CompletionPolicy": "./src/CompletionPolicy.ts",
    "./RepairHost": "./src/RepairHost.ts",
    "./RepairModel": "./src/RepairModel.ts",
    "./RepairProgram": "./src/RepairProgram.ts",
    "./Publisher": "./src/Publisher.ts",
    "./RepairSandbox": "./src/RepairSandbox.ts"
  },
  "scripts": {
    "typecheck": "tsc-rs --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "cc-session-io": "0.4.0",
    "effect": "4.0.5",
    "pi-claude-bridge": "0.9.3",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/bridge.mjs",
      "./src/inbox.ts"
    ]
  }
}
